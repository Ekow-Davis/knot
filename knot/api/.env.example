# Copy to api/.env for local development. On Railway, set these in the service's Variables tab.

ENV=development
DATABASE_URL=postgresql://knot:knot@localhost:5432/knot

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
BANK_KEY=

# The one email allowed to create the pair (yours).
OWNER_EMAIL=

RESEND_API_KEY=
MAIL_FROM=no-reply <no-reply@forgottenguardian.com>

# Session 7 (push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@forgottenguardian.com

APP_ORIGIN=http://localhost:5173
